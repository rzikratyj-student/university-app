# Build context allowlist: real configuration and local data never enter it.
**
!Dockerfile
!requirements.txt
!config.py
!run.py
!app/
!app/**
!migrations/
!migrations/**
!tests/
!tests/**
!scripts/
!scripts/start_web.py
**/__pycache__/
**/*.py[cod]
**/.env*
**/*.db
**/*.sqlite*
**/*.dump
**/*.backup
**/*.log
**/*.key
**/*.pem
**/.git/
**/.local/
**/.venv/
**/secrets/
